{
  "name": "agent-data-api",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-call SEO data APIs for AI agents (x402 + DataForSEO)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:sandbox": "./scripts/sandbox-smoke.sh",
    "wallet:test": "tsx scripts/create-test-wallet.ts",
    "e2e:testnet": "tsx --env-file=.env.buyer scripts/e2e-testnet.ts",
    "start:stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@coinbase/x402": "2.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/mcp": "2.28.0",
    "express": "5.3.0",
    "nodemailer": "10.0.16",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "bin": {
    "cfp-seo-agent-stdio": "dist/stdio.js"
  }
}
