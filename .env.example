# Copy to .env and fill in. Never commit .env.  (chmod 600 .env)

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Number of reverse proxies in front of the app (1 behind Caddy), used for client IPs in rate limiting.
TRUST_PROXY=0
DB_PATH=./data/app.db
LOG_LEVEL=info

# --- DataForSEO -------------------------------------------------------------
# sandbox = free dummy data from sandbox.dataforseo.com (same response shape)
# live    = real data from api.dataforseo.com, costs money
DATAFORSEO_MODE=sandbox
# API login + API password from https://app.dataforseo.com/api-access (NOT your account password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_TIMEOUT_MS=45000
# Hard spending limits for live mode (USD). Requests that would exceed them are refused before payment.
DATAFORSEO_DAILY_LIMIT_USD=5
DATAFORSEO_MONTHLY_LIMIT_USD=100

# Comma-separated service ids to switch off without a rebuild, e.g. keyword-ideas,competitors
DISABLED_SERVICES=

# --- Payments (x402, USDC on Base) -------------------------------------------
# off     = no payment, ONLY allowed together with DATAFORSEO_MODE=sandbox (local development)
# testnet = Base Sepolia (eip155:84532), test USDC
# mainnet = Base (eip155:8453), real USDC — only after successful testnet runs
PAYMENT_MODE=off
# Public wallet address that receives USDC. No private key is ever needed on the server.
PAY_TO_ADDRESS=
# Testnet default: https://x402.org/facilitator (no auth). Mainnet: CDP facilitator (needs the keys below).
FACILITATOR_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Testnet USDC is free but live DataForSEO calls are not: must be set explicitly to combine them.
ALLOW_LIVE_DATA_ON_TESTNET=false

# --- Admin (/admin, HTTP Basic auth) -----------------------------------------
ADMIN_USER=admin
# >= 16 characters required in production. Generate: openssl rand -base64 24
ADMIN_PASSWORD=

# --- Public site / discovery ---------------------------------------------------
SITE_NAME=Agent Data API
# Shown on the website and in OpenAPI (info.contact). Leave empty until you have one.
CONTACT_EMAIL=
# Optional: comma-separated wallet signatures proving you own PAY_TO (see docs/MARKETPLACES.md)
OWNERSHIP_PROOFS=
# Verification files for directories (see docs/MARKETPLACES.md); leave empty until a directory asks for them.
WELLKNOWN_402INDEX=
WELLKNOWN_MCP_REGISTRY_AUTH=
WELLKNOWN_GLAMA=

# --- Data retention -------------------------------------------------------------
# Request inputs and results are deleted after this many days. Payment records (amount, time, wallet address, tx hash) stay.
RETENTION_DAYS=30

# --- E-mail alerts (optional) -----------------------------------------------------
# Budget at 80 %/100 %, paid requests needing attention, daily summary at 07:00 UTC. Off unless all four are set.
# Test: npx tsx --env-file=.env.production scripts/test-alert.ts
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Free sample --------------------------------------------------------------
# One free keyword-metrics call per client per day. This is the TOTAL number of real (live) calls per UTC day (each costs ~$0.09). 0 = off.
FREE_SAMPLE_DAILY_LIMIT=0
# Optional temporary higher limit (e.g. launch day) until the given UTC time, then FREE_SAMPLE_DAILY_LIMIT applies again
FREE_SAMPLE_BOOST_LIMIT=0
FREE_SAMPLE_BOOST_UNTIL=

# --- Abuse protection ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# --- Deployment (docker compose + Caddy) -----------------------------------------
# Public host name served by Caddy (DNS A/AAAA record must point to the server).
DOMAIN=agent.example.com

# Optional: independent public status page, linked on /status (link only)
EXTERNAL_STATUS_URL=
