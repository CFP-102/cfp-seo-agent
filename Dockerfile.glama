# Dockerfile for automated MCP checks (e.g. Glama): MCP over stdio in sandbox mode, without secrets or payments.
FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY src ./src
COPY public ./public
RUN npm ci --ignore-scripts && npm run build
USER node
CMD ["node", "dist/stdio.js"]
